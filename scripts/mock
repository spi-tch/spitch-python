#!/usr/bin/env python3
"""Run a command against the SDK's local HTTP fixtures, using an ephemeral port."""
import json
import os
import re
import subprocess
import sys
import threading
from email import policy
from email.parser import BytesParser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlsplit

FIXTURES = json.loads((Path(__file__).with_name("http-fixtures.json")).read_text())


class Handler(BaseHTTPRequestHandler):
    def respond(self, status, body, content_type="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def handle_request(self):
        url = urlsplit(self.path)
        route = re.sub(r"^(/v1/files/)[^/]+", r"\1{id}", url.path)
        fixture = FIXTURES.get(self.command + " " + route)
        if not fixture:
            return self.respond(404, {"error": "unknown route"})
        if not self.headers.get("Authorization", "").startswith("Bearer "):
            return self.respond(401, {"error": "missing bearer token"})
        try:
            query = parse_qs(url.query, keep_blank_values=True)
            for name, values in query.items():
                if name not in fixture.get("query", []) or (name in {"ttl", "limit"} and not values[0].isdigit()):
                    raise ValueError("invalid query parameter " + name)
            if self.command == "POST":
                media = self.headers.get("Content-Type", "")
                raw = self.rfile.read(int(self.headers.get("Content-Length", "0")))
                if media.startswith("multipart/form-data") and fixture.get("multipart"):
                    msg = BytesParser(policy=policy.default).parsebytes(b"Content-Type: " + media.encode() + b"\r\n\r\n" + raw)
                    fields = {part.get_param("name", header="content-disposition"): part.get_payload(decode=True) for part in msg.iter_parts()}
                elif media.startswith("application/json") and not fixture.get("multipart"):
                    fields = json.loads(raw)
                else:
                    raise ValueError("unexpected content type")
                if not isinstance(fields, dict) or not all(fields.get(key) for key in fixture["required"]):
                    raise ValueError("missing required request fields")
        except (ValueError, TypeError) as error:
            return self.respond(422, {"error": str(error)})
        if fixture.get("audio"):
            fmt = fields.get("format", "wav")
            if fmt not in {"wav", "mp3"}:
                return self.respond(422, {"error": "fixture supports wav and mp3"})
            audio = (Path(__file__).parent / "fixtures" / ("silence." + fmt)).read_bytes()
            self.send_response(200)
            self.send_header("Content-Type", "audio/mpeg" if fmt == "mp3" else "audio/wav")
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            for offset in range(0, len(audio), 128):
                chunk = audio[offset:offset + 128]
                self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
            self.wfile.write(b"0\r\n\r\n")
            return
        self.respond(200, fixture["response"])

    do_GET = do_POST = do_DELETE = handle_request

    def log_message(self, *_args):
        pass


if __name__ == "__main__":
    with ThreadingHTTPServer(("127.0.0.1", 0), Handler) as server:
        threading.Thread(target=server.serve_forever, daemon=True).start()
        env = dict(os.environ, TEST_API_BASE_URL="http://127.0.0.1:%d" % server.server_port)
        try:
            sys.exit(subprocess.call(sys.argv[1:], env=env))
        finally:
            server.shutdown()
